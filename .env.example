# WA WEB ULTRA — marketing site environment.
# Copy to .env.local and fill in. All are optional; sensible fallbacks apply.

# Chrome Web Store item URL. While UNSET, every "Add to Chrome" button renders
# as a disabled "Coming soon to the Chrome Web Store" state instead of a link.
# Set this once the extension is published to turn the CTAs live.
NEXT_PUBLIC_STORE_URL=

# Public support/contact email shown on /support, /privacy and in the footer.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# LEAVE EMPTY to disable analytics entirely — no GA script AND no cookie bar.
# Keep it empty for local dev and preview deploys.
NEXT_PUBLIC_GA_ID=

# Absolute site origin, used for canonical URLs, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://wawebultra.com
